# .env.example — copy to .env for local dev
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# CORS — your Railway domain goes here after deployment
# Railway gives you: https://yourapp.up.railway.app (free)
ALLOWED_ORIGINS=http://localhost:3001

# No HIBP API key needed — we use the free k-Anonymity endpoint
# No Redis URL needed — we use node-cache (in-memory, free)
# No AWS credentials — Railway handles everything
